# Mẫu, không dùng các giá trị này để vận hành thật. Không commit .env.production.
APP_DOMAIN=crm.example.com
PUBLIC_APP_URL=https://crm.example.com
ACME_EMAIL=admin@example.com
POSTGRES_USER=crm_admin
POSTGRES_DB=crm_runtime
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
APP_DATABASE_USER=crm_runtime
APP_DATABASE_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_PASSWORD
# URL-encode mật khẩu nếu có ký tự đặc biệt.
LOCAL_DATABASE_URL=postgresql://crm_runtime:REPLACE_WITH_DIFFERENT_LONG_RANDOM_PASSWORD@postgres:5432/crm_runtime
LOCAL_ALLOWED_ORIGINS=https://crm.example.com
# Đăng nhập chỉ dùng mật khẩu SQL. URL/khóa bên dưới chỉ dành cho đồng bộ nguồn.
SUPABASE_URL=https://REPLACE_PROJECT.supabase.co
LOCAL_SYNC_AUTO=false
LOCAL_INTEGRATION_API=false
# Nếu chuẩn bị đồng bộ chỉ đọc từ public, thêm khóa nguồn phía server tại file riêng.
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SOURCE_READ_KEY

