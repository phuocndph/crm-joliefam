VITE_BACKEND_MODE=local
VITE_LOCAL_DEMO_AUTH=true
LOCAL_DEMO_AUTH=true
VITE_LOCAL_API_URL=http://127.0.0.1:8787
LOCAL_DATABASE_URL=postgres://crm_local:crm_local_dev_only@127.0.0.1:55432/crm_local
LOCAL_API_PORT=8787
# Agent API/MCP mặc định tắt. Chỉ bật sau khi cấu hình quyền và khóa.
LOCAL_INTEGRATION_API=false
# Đăng nhập local chỉ kiểm tra mật khẩu SQL local; không gọi Supabase Auth.
# Biến LOCAL_AUTH_SUPABASE_BRIDGE cũ không còn được backend sử dụng.
# Optional automatic Supabase -> local incremental sync scheduler.
# LOCAL_SYNC_INTERVAL_MINUTES=5
# LOCAL_SYNC_AUTO=true
# Optional: keep this file local-only; never commit a real key.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-local-secret
# Or use a short-lived authenticated user token for RLS-scoped sync:
# SUPABASE_USER_ACCESS_TOKEN=replace-with-local-token
